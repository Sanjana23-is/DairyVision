# ==============================================================================
# DairyVision AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the frontend directory:
#   cp .env.example .env
#
# NOTE: The frontend communicates strictly with the backend REST API.
# Do NOT place Supabase secret/service-role keys or direct database URLs here.
# ==============================================================================

# Backend API Base URL (Default: http://localhost:8000)
VITE_API_URL=http://localhost:8000
