# ==============================================================================
# DairyVision AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend directory:
#   cp .env.example .env
#
# Replace placeholders ([...]) with your actual project credentials.
# Never commit real secrets, API keys, or database passwords to Git.
# ==============================================================================

# Application Settings
APP_NAME="DairyVision AI Backend"
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend & CORS Configuration
# Supports either a JSON array (e.g. ["http://localhost:3000","http://localhost:5173"]) or a comma-separated string.
# The base development origin (http://localhost:3000) is always guaranteed by backend fallback.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://localhost","http://127.0.0.1:3000","http://127.0.0.1:3001"]
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Connection Strings (psycopg 3 driver: postgresql+psycopg://...)
# ------------------------------------------------------------------------------
# OPTION A — Local PostgreSQL (Fastest for offline development):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dairyvision
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dairyvision
#
# OPTION B — Supabase Cloud Database:
# Notes:
# 1. DATABASE_URL can use Supabase Transaction Pooler (port 6543) or Session Pooler / Direct (port 5432).
#    User format for pooler: postgres.<project-ref>
#    Host for pooler: aws-0-[region].pooler.supabase.com:6543
# 2. ALEMBIC_DATABASE_URL MUST use port 5432 (Direct or Session Pooler), NOT port 6543 transaction pooler,
#    because DDL schema migrations require session-level locks.
DATABASE_URL=postgresql+psycopg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Authentication & Project Keys
# ------------------------------------------------------------------------------
# Find these under: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[project-ref].supabase.co
# Anon / Publishable Key (safe for public clients)
SUPABASE_PUBLISHABLE_KEY=[your-supabase-publishable-key]
# Service Role Secret Key (REQUIRED by backend for admin user creation and email auto-confirmation)
# NEVER expose this key in frontend code or commit to source control!
SUPABASE_SECRET_KEY=[your-supabase-service-role-secret-key]
# Supabase JWT Secret (Find under: Project Settings -> API -> JWT Settings -> JWT Secret)
# Used for in-memory cryptographic verification of access tokens (<1ms latency)
SUPABASE_JWT_SECRET=[your-supabase-jwt-secret]
